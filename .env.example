# Purpose: Placeholder-only template of required environment variables; never real secrets.
# Owner: Rajdeep
# Authority: Aligned with AGENTS.md Section 4, 12 and docs/deployment.md
# Copy this file to .env and customize for your target serving environment:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)

# =============================================================================
# Serving Adapter Selection
# Options:
#   - vllm    : Local vLLM instance (default, high-throughput GPU serving)
#   - local   : Local Ollama daemon (developer workstation / local LLMs)
#   - nebius  : Nebius Cloud remote inference endpoints
#   - fake    : In-process deterministic simulated adapter (Zero-GPU CPU Demo)
# =============================================================================
SLOKERN_ADAPTER=vllm

# =============================================================================
# Local vLLM Serving Configuration (when SLOKERN_ADAPTER=vllm)
# =============================================================================
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL_ID=slokern-qwen3-1.7b
VLLM_TIMEOUT_S=30.0

# =============================================================================
# Local Ollama Serving Configuration (when SLOKERN_ADAPTER=local)
# =============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_ID=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TIMEOUT_S=30.0

# =============================================================================
# Nebius Cloud Remote API Configuration (when SLOKERN_ADAPTER=nebius)
# =============================================================================
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL_ID=Qwen/Qwen2.5-Coder-7B-Instruct

# =============================================================================
# SLOKern Control Plane HTTP API Configuration
# =============================================================================
SLOKERN_API_HOST=127.0.0.1
SLOKERN_API_PORT=8001
SLOKERN_ARTIFACTS_DIR=artifacts
SLOKERN_LOG_HTTP=0
