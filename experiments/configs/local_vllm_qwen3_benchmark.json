{
  "experiment_id": "exp-local-vllm-qwen3-tuning",
  "workload": {
    "schema_version": "1.0.0",
    "workload_name": "local-vllm-qwen3-workload",
    "fixture_id": "fix-qwen3-chat-01",
    "arrival_mode": "constant",
    "target_offered_rate": 0.4,
    "concurrency_limit": 2,
    "warmup_duration_s": 3,
    "measurement_duration_s": 8,
    "max_input_tokens": 128,
    "max_output_tokens": 32
  },
  "slo": {
    "slo_id": "slo-local-vllm-qwen3-01",
    "constraints": [
      {
        "metric_name": "ttft_ms",
        "statistic": "p95",
        "threshold": 3000.0,
        "unit": "ms",
        "operator": "<="
      },
      {
        "metric_name": "itl_ms",
        "statistic": "p50",
        "threshold": 40.0,
        "unit": "ms",
        "operator": "<="
      },
      {
        "metric_name": "error_rate",
        "statistic": "mean",
        "threshold": 0.05,
        "unit": "fraction",
        "operator": "<="
      }
    ],
    "min_sample_count": 3
  },
  "search_space": {
    "concurrency": [1, 2],
    "max_tokens": [32, 128]
  },
  "budget": {
    "max_candidates": 5,
    "max_wallclock_seconds": 600,
    "max_cost_limit": null
  },
  "verification_policy": {
    "repetitions": 1,
    "duration_multiplier": 1.0,
    "min_absolute_latency_drift_ms": 25.0
  }
}
